{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CreatorX",
  "version": "0.0.7",
  "identifier": "cc.anjing.creatorx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1438",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CreatorX",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 440,
        "center": true,
        "resizable": true,
        "theme": "Light",
        "backgroundColor": "#f7f5ef",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/library/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENUQwRDkzMUY1RjM1NzQKUldSME5WOGZrdzFkM1RmQ3hJMWxSbDlHMHJGVldrbjF1emRubXpxQnJhb1BPTVZDZzdiNUl6cXUK",
      "endpoints": [
        "https://github.com/anjing-le/happy-creator-journey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
